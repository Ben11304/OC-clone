{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dataset Catalog",
  "type": "object",
  "additionalProperties": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string"
      },
      "name": {
        "type": "string"
      },
      "year": {
        "type": [
          "integer",
          "null"
        ]
      },
      "data_modality": {
        "type": [
          "string",
          "null"
        ]
      },
      "num_images": {
        "type": [
          "string",
          "integer",
          "null"
        ]
      },
      "num_classes": {
        "type": [
          "integer",
		  "string",
          "null"
        ]
      },
      "classes": {
        "type": [
          "array",
          "null"
        ],
        "items": {
          "type": "string"
        }
      },
      "annotation_types": {
        "type": [
          "array",
          "null"
        ],
        "items": {
          "type": "string"
        }
      },
      "potential_tasks": {
        "type": [
          "array",
          "null"
        ],
        "items": {
          "type": "string"
        }
      },
      "license": {
        "type": [
          "string",
          "null"
        ]
      },
      "paper": {
        "type": [
          "string",
          "null"
        ]
      },
      "access": {
        "type": [
          "string",
          "null"
        ]
      },
      "distribution": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["content_url", "filename"],
          "properties": {
            "provider": { "type": "string" },
            "content_url": { "type": "string", "format": "uri" },
            "filename": { "type": "string" },
            "encoding_format": { "type": "string" },
            "content_size": { "type": "integer", "minimum": 0 },
            "revision": { "type": "string" },
            "download_method": { "type": "string", "enum": ["navigate", "fetch"] },
            "browser_download": { "type": "boolean" }
          },
          "additionalProperties": false
        }
      },
      "programmatic_access": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["provider", "method", "scope"],
          "properties": {
            "provider": { "type": "string" },
            "method": { "type": "string", "enum": ["huggingface_snapshot", "github_clone", "figshare_files", "dataverse_collection", "designsafe_globus", "google_drive_folder", "http_files", "dreamhouse_setup", "roboflow_version", "kaggle_competition", "baidu_share_transfer"] },
            "repo_id": { "type": "string", "pattern": "^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$" },
            "record_id": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
            "collection_id": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
            "resource_id": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
            "folder_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
            "workspace_id": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
            "project_id": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
            "version": { "type": "string", "pattern": "^[0-9]+$" },
            "export_format": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
            "competition_id": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
            "share_url": { "type": "string", "format": "uri", "pattern": "^https://(?:www\\.)?pan\\.baidu\\.com/s/[A-Za-z0-9_-]+/?$" },
            "extraction_code": { "type": "string", "pattern": "^[A-Za-z0-9]{4,8}$" },
            "api_url": { "type": "string", "format": "uri" },
            "source_path": { "type": "string" },
            "repository_type": { "type": "string", "enum": ["dataset"] },
            "revision": { "type": "string", "pattern": "^[A-Za-z0-9._/-]+$" },
            "scope": { "type": "string", "enum": ["full"] },
            "requires_auth": { "type": "boolean" },
            "notice": { "type": "string" },
            "documentation_url": { "type": "string", "format": "uri" }
          },
          "additionalProperties": false
        }
      },
      "image_url": {
        "type": [
          "string",
          "null"
        ]
      },
      "authors": {
		  "type": ["string", "array", "null"],
		  "items": {
			"oneOf": [
			  { "type": "string" },
			  {
				"type": "object",
				"properties": {
				  "name": { "type": "string" },
				  "url": { "type": "string", "format": "uri" }
				},
				"required": ["name"],
				"additionalProperties": false
			  }
			]
		  }
		}
		,
      "doi": {
        "type": [
          "string",
          "null"
        ]
      }
    },
	"note": {
	  "type": ["string", "null"],
	  "description": "Additional notes, caveats, or remarks about the dataset."
	},
    "required": [
      "id",
      "name"
    ],
    "additionalProperties": true
  }
}
